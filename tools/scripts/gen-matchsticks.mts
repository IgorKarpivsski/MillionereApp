// Generates the matchstick puzzle set (packages/shared/src/matchPuzzles.ts).
// Every puzzle starts false and has exactly ONE true equation reachable with
// the allowed moves (checked by the solver), so there is always a clear answer.
//
//   node --experimental-strip-types tools/scripts/gen-matchsticks.mts <path-to-shared-src-matchsticks.ts> <out.ts>
import { writeFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';

const M = await import(pathToFileURL(process.argv[2]!).href);
const { solve, parseEquation, readEquation, isTrueEquation } = M;

let seed = 20261015;
const rnd = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [a[i], a[j]] = [a[j]!, a[i]!]; } return a; };

function candidates(maxA: number, maxB: number, maxC: number): string[] {
  const out: string[] = [];
  for (let a = 0; a <= maxA; a++) for (let b = 0; b <= maxB; b++) for (const op of ['+', '-']) for (let c = 0; c <= maxC; c++) {
    const eq = `${a}${op}${b}=${c}`;
    if (!isTrueEquation(eq)) out.push(eq);
  }
  return out;
}

type P = { start: string; mode: 'move' | 'add' | 'remove'; count: number; answer: string; level: number };
const found: P[] = [];
const seenStart = new Set<string>();

function tryAdd(start: string, mode: P['mode'], count: number, level: number) {
  const k = start + mode + count;
  if (seenStart.has(k)) return false;
  const sols = [...solve(start, mode, count)];
  if (sols.length !== 1) return false;
  seenStart.add(k);
  const answer = sols[0]!;
  // "Out of the box" bonus: the sign or the side of the equation changes.
  const tricky = answer.replace(/\d/g, '') !== start.replace(/\d/g, '') || answer.length !== start.length;
  found.push({ start, mode, count, answer, level: Math.min(5, level + (tricky ? 1 : 0)) });
  return true;
}

const single = shuffle(candidates(9, 9, 18));
let n = 0;
for (const eq of single) { if (tryAdd(eq, 'move', 1, 1)) n++; if (n >= 170) break; }
n = 0;
for (const eq of shuffle([...single])) { if (tryAdd(eq, 'add', 1, 1)) n++; if (n >= 70) break; }
n = 0;
for (const eq of shuffle([...single])) { if (tryAdd(eq, 'remove', 1, 1)) n++; if (n >= 70) break; }
const double = shuffle(candidates(29, 19, 39).filter((e) => /\d\d/.test(e)));
n = 0;
for (const eq of double.slice(0, 4000)) { if (tryAdd(eq, 'move', 1, 3)) n++; if (n >= 90) break; }
n = 0;
for (const eq of shuffle([...single]).slice(0, 900)) { if (tryAdd(eq, 'move', 2, 3)) n++; if (n >= 110) break; }
n = 0;
for (const eq of double.slice(4000, 4600)) { if (tryAdd(eq, 'move', 2, 4)) n++; if (n >= 40) break; }

found.sort((a, b) => a.level - b.level || a.count - b.count || a.start.length - b.start.length);
// Interleave modes inside each level so the path stays varied.
const byLevel = new Map<number, P[]>();
for (const p of found) byLevel.set(p.level, [...(byLevel.get(p.level) ?? []), p]);
const ordered: P[] = [];
for (const [, ps] of [...byLevel].sort((a, b) => a[0] - b[0])) {
  const groups = new Map<string, P[]>();
  for (const p of ps) groups.set(p.mode + p.count, [...(groups.get(p.mode + p.count) ?? []), p]);
  const gs = [...groups.values()];
  while (gs.some((g) => g.length)) for (const g of gs) if (g.length) ordered.push(g.shift()!);
}
const rows = ordered.map((p, i) => `  [${i + 1}, '${p.start}', '${p.mode}', ${p.count}, '${p.answer}', ${p.level}],`);
writeFileSync(process.argv[3]!, `// Generated by tools/scripts/gen-matchsticks.mts — do not edit by hand.
// ${ordered.length} puzzles, each with exactly one reachable true equation.
import type { MatchMode, MatchPuzzle } from './matchsticks';

const RAW: [number, string, MatchMode, number, string, number][] = [
${rows.join('\n')}
];

export const MATCH_PUZZLES: MatchPuzzle[] = RAW.map(([id, start, mode, count, answer, level]) => ({ id, start, mode, count, answer, level }));
`);
const lv: Record<number, number> = {};
for (const p of ordered) lv[p.level] = (lv[p.level] ?? 0) + 1;
console.log(ordered.length, lv, ordered.slice(0, 5));
